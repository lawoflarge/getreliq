# Anthropic API Key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# eBay Partner Network — https://partnernetwork.ebay.com
EBAY_CAMP_ID=YOUR_CAMPAIGN_ID

# Catawiki Partnerize — https://join.partnerize.com/catawiki/en
# After signup, wrap search URLs with your Partnerize tracking link
CATAWIKI_TRACKING_PREFIX=https://www.catawiki.com/de/s

# Pamono via FlexOffers — https://www.flexoffers.com
# After approval, use your FlexOffers tracking URL
PAMONO_TRACKING_PREFIX=https://www.pamono.de/search
